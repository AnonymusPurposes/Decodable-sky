Cell[CellGroupData[{

Cell["Q_text saturation with corpus size (Issue 3)", "Section"],

Cell[CellGroupData[{

Cell["\<\
(* x: tokens of the corpus stage (log scale). Stages are nested: the pilot \
web sample (C4 + FineWeb) in
   prefixes of 1/16 ... 1 (12-187 B tokens), then the whole pilot web plus a \
growing prefix of the extended
   FineWeb parts (237-975 B); open circles: Wikipedia alone (2.85 B, the \
paper's corpus). Gated counts,
   positive eigenvalues, all modes (satTop10 = True adds the top-10-mode \
versions, dashed).
   Blue: baseline from the object-object table, observed diagonal (Figure \
10's 975B column);
   red: M* as in appendix F.3, zero diagonal (the published Q_text).
   Left: fit, Pearson r of the Q_text RDM with the neural RDM on \
constellation pairs, mean over the six strong
   models, on Figure 10's footing (full standardized residual stream); band: \
95% over constellation resamples; green: the sphere S^2 on the same footing.
   Right: split-half reliability, Pearson r between the Q_text RDMs of the \
two halves of each stage (even / odd
   count files, i.e. each half has half the tokens); satSB = True plots the \
Spearman-Brown estimate 2r/(1+r)
   for the full stage instead. Data: rebuttal/cooc/qtext_saturation.py -> \
data/rdm/qtext_saturation.csv *)
SAT = readCSV[\"rdm/qtext_saturation.csv\"];
satCons = {{\"within\", RGBColor[0, 0, 0.85], \"baseline from the \
object-object table (Fig. 10: 975B)\"},
   {\"faithful\", RGBColor[0.85, 0, 0], \"M* as in appendix F.3 \
(published)\"}};
satTop10 = False; satSB = False;
satW = 2.5; satT = {1, 1000};
satX[t_] := satW*Log10[t/satT[[1]]]/Log10[satT[[2]]/satT[[1]]];
satSer[c_, ser_] := SortBy[Select[SAT, #construction === c && #series === ser \
&], #[\"tokens_B\"] &];
satSph = row1[SAT, #construction === \"sphere\" &];
satPanel[key_, {lo_, hi_}, step_, title_, ref_] := Module[{gy, cons},
   gy[v_] := (Clip[v, {lo, hi}] - lo)/(hi - lo);
   cons = If[satTop10, Join[satCons, {#[[1]] <> \"_top10\", #[[2]], #[[3]]} & \
/@ satCons], satCons];
   Graphics[{
     Thickness[0.001], GrayLevel[0.8], Table[Line[{{0, gy[y]}, {satW, \
gy[y]}}], {y, lo + step, hi - step/2, step}],
     If[ref, {RGBColor[0, 0.75, 0], Opacity[bandOpacity], EdgeForm[], \
Rectangle[{0, gy[satSph[\"fit_lo\"]]}, {satW, gy[satSph[\"fit_hi\"]]}],
       Opacity[1], Thickness[0.004], Line[{{0, gy[satSph[\"fit\"]]}, {satW, \
gy[satSph[\"fit\"]]}}],
       Text[Style[Superscript[\"S\", 2], 13], {0.12, gy[satSph[\"fit\"]] + \
0.06}]}, {}],
     Table[With[{s = satSer[c[[1]], \"nested\"], wk = satSer[c[[1]], \
\"wikipedia\"], col = c[[2]],
        dash = If[StringEndsQ[c[[1]], \"_top10\"], Dashing[{0.012, 0.008}], \
Dashing[None]]},
       {If[key === \"fit\", {col, Opacity[bandOpacity], EdgeForm[],
          Polygon[Join[{satX[#[\"tokens_B\"]], gy[#[\"fit_lo\"]]} & /@ s, \
Reverse[{satX[#[\"tokens_B\"]], gy[#[\"fit_hi\"]]} & /@ s]]]}, {}],
        {col, Opacity[1], dash, Thickness[0.004], \
Line[{satX[#[\"tokens_B\"]], gy[#[key]]} & /@ s]},
        {col, PointSize[0.014], Point[{satX[#[\"tokens_B\"]], gy[#[key]]} & \
/@ s]},
        Table[If[NumericQ[r[key]], {White, Disk[{satX[r[\"tokens_B\"]], \
gy[r[key]]}, 0.035], col, Thickness[0.002],
           Circle[{satX[r[\"tokens_B\"]], gy[r[key]]}, 0.035]}, {}], {r, \
wk}]}], {c, cons}],
     Black, Thickness[0.001], Line[{{0, 0}, {satW, 0}, {satW, 1}, {0, 1}, {0, \
0}}],
     Table[{Line[{{satX[t], 0}, {satX[t], -0.04}}], Text[t, {satX[t], \
-0.1}]}, {t, {1, 10, 100, 1000}}],
     Table[Line[{{satX[m*10^e], 0}, {satX[m*10^e], -0.02}}], {e, 0, 2}, {m, \
2, 9}],
     Table[{Line[{{0, gy[y]}, {-0.03, gy[y]}}], Text[y, {-0.13, gy[y]}]}, {y, \
lo, hi, step}],
     Text[Style[\"tokens, billions (log scale)\", 12], {satW/2, -0.22}], \
Text[Style[title, Bold, 12], {satW/2, 1.08}]},
    ImageSize -> 430]];
satLegend = Graphics[Table[{satCons[[j, 2]], Thickness[0.004], Line[{{3.3*(j \
- 1), 0}, {3.3*(j - 1) + 0.3, 0}}],
      Black, Text[Style[satCons[[j, 3]], 11], {3.3*(j - 1) + 0.4, 0}, {-1, \
0}]}, {j, Length[satCons]}]~Join~
     {{Black, Text[Style[\"\[EmptyCircle]\", 15], {6.85, 0}], \
Text[Style[\"Wikipedia alone\", 11], {6.95, 0}, {-1, 0}]},
      {RGBColor[0, 0.75, 0], Thickness[0.004], Line[{{8.6, 0}, {8.9, 0}}], \
Black, Text[Style[Row[{\"sphere \", Superscript[\"S\", 2]}], 11], {9.0, 0}, \
{-1, 0}]}},
   ImageSize -> 900, AspectRatio -> 0.03];
figSat = Column[{GraphicsRow[{satPanel[\"fit\", {0.3, 0.8}, 0.1, \"fit to the \
neural RDM (mean of six models)\", True](*,
      satPanel[If[satSB, \"spearman_brown\", \"split_half\"], {0, 1}, 0.1, \
If[satSB, \"reliability (Spearman-Brown)\", \"split-half reliability\"], \
False]*)}, ImageSize -> 400](*,
    satLegend*)}, Alignment -> Center];
Export[FileNameJoin[{out, \"qtext_saturation.pdf\"}], figSat];
figSat\
\>", "Input",
 CellChangeTimes->{{4.0037847742586813`*^9, 4.0037848253139043`*^9}, {
  4.003784864299302*^9, 4.0037848644017096`*^9}},
 CellLabel->"In[66]:=",ExpressionUUID->"b5c86bee-bf6e-4b9b-8cb6-f99ce2d36742"],


Notebook[{

Cell[CellGroupData[{
Cell["Rebuttal figures", "Title"],

Cell["\<\
Rebuttal versions of the paper's figures, in the style of ai_plots.nb. Run \
the Setup cell first; every other section is independent. Inputs: data/ next \
to this notebook (rebuild with prepare_data.py); outputs: pdf/. Section \
comments say what changed relative to the paper.\
\>", "Text"],

Cell[CellGroupData[{

Cell["Setup (run first)", "Section"],

Cell["\<\
(* Rebuttal versions of the paper figures. Each section follows the matching \
cell of ai_plots.nb;
   inputs are in data/ next to this notebook (made by prepare_data.py), PDFs \
go to pdf/. *)
If[! StringQ[figDir], figDir = NotebookDirectory[]];
data = FileNameJoin[{figDir, \"data\"}];
out = If[StringQ[figOut], figOut, FileNameJoin[{figDir, \"pdf\"}]];   (* \
figOut: optional other output folder *)
If[! DirectoryQ[out], CreateDirectory[out]];
readCSV[f_] := Module[{t = Import[FileNameJoin[{data, f}], \"CSV\"]}, \
AssociationThread[First[t], #] & /@ Rest[t]];
row1[rows_, crit_] := First[Select[rows, crit]];
runs[mask_] := Select[Split[Range[Length[mask]], mask[[#1]] === mask[[#2]] \
&], mask[[First[#]]] && Length[#] > 1 &];
models = {\"mistrallarge123b\", \"glm45air\", \"qwen235b\", \"qwen32b\", \
\"llama33_70b\", \"mixtral8x22b\", \"gptoss120b\", \"gptoss120b_harmony\"};
mmodels = {\"Mistral Large 2\", \"GLM-4.5-Air\", \"Qwen3-235B\", \
\"Qwen3-32B\", \"Llama-3.3-70B\", \"Mixtral-8x22B\", \"gpt-oss-120b\", \
Row[{\"gpt-oss-120\", Superscript[\"b\", \"*\"]}]};
cols = {{1, 0, 0}, {0.9, 0.5, 0}, {0.8, 0.8, 0}, {0, 0.75, 0}, {0, 0.6, 0.8}, \
{0.5, 0, 0.6}, {0.5, 0.5, 0.5}};
bandOpacity = 0.18;   (* 5-95% bands over the 100 splits *)
nullGray = GrayLevel[0.55]; nullOpacity = 0.22;   (* permutation null of the \
angle *)\
\>", "Input",
 CellLabel->"In[1]:=",ExpressionUUID->"930dd9a8-f284-4490-b305-54eb2abcf283"]
}, Open  ]],

Cell[CellGroupData[{

Cell["\<\
Figure 2: decodability across normalized depth (80/20 splits, PCA fitted on \
training objects)\
\>", "Section"],

Cell["\<\
k2 = 8;
minR2band = 0.05;   (* bands are drawn only where the median R^2 exceeds \
this, to keep early layers readable *)
S2 = Table[readCSV[\"split/\" <> m <> \"_split_r2_\" <> ToString[k2] <> \
\".csv\"], {m, models[[1 ;; 7]]}];
N2 = Table[readCSV[\"null/k8/\" <> m <> \"_angle_null.csv\"], {m, models[[1 \
;; 7]]}];
w = 2; x2[la_, l_] := w*(la - 1)/(l - 1);
yR[v_] := Clip[v, {0, 1}]; yA[v_] := Clip[1 - v/90, {0, 1}];
band2[s_, f_, lo_, hi_] := Module[{t = S2[[s]], l = Length[S2[[s]]], mask},
   mask = (#[\"r2\"] > minR2band) & /@ t;
   {Opacity[bandOpacity], RGBColor @@ cols[[s]], EdgeForm[],
    Table[Polygon[Join[Table[{x2[la, l], f[t[[la, lo]]]}, {la, r}], \
Table[{x2[la, l], f[t[[la, hi]]]}, {la, Reverse[r]}]]], {r, runs[mask]}]}];
(* null averaged over the 7 models at the same normalized depth *)
nullAt[key_] := Table[Mean[Table[Interpolation[Table[{(la - \
1)/(Length[N2[[s]]] - 1), N2[[s, la, key]]}, {la, Length[N2[[s]]]}], \
InterpolationOrder -> 1][u], {s, 7}]], {u, 0, 1, 0.01}];
nul2 = {nullAt[\"null_ang_p05\"], nullAt[\"null_ang_p50\"], \
nullAt[\"null_ang_p95\"]};
panel2[f_, c_, lo_, hi_, labs_, extra_] := Graphics[{
    Thickness[0.001], Table[{GrayLevel[0.75], Line[{{w - 1.3 + i/30, i/10}, \
{w, i/10}}]}, {i, 1, 9}],
    extra,
    Table[band2[s, f, lo, hi], {s, 7, 1, -1}],
    Thickness[0.004], Opacity[1],
    Table[{RGBColor @@ cols[[s]], Line[Table[{x2[la, Length[S2[[s]]]], \
f[S2[[s, la, c]]]}, {la, 1, Length[S2[[s]]]}]],
      Text[Style[mmodels[[s]], 13], {0.4, 1.05 - s/7.7}]}, {s, 7, 1, -1}],
    Black, Thickness[0.001], Line[{{0, 0}, {0, 1}, {w, 1}, {w, 0}, {0, 0}}], \
labs}, ImageSize -> 420];
nullBand2 = {nullGray, Opacity[nullOpacity], EdgeForm[],
   Polygon[Join[Table[{w*(i - 1)/100, yA[nul2[[1, i]]]}, {i, 101}], \
Table[{w*(i - 1)/100, yA[nul2[[3, i]]]}, {i, 101, 1, -1}]]],
   Opacity[1], Dashing[{0.01, 0.01}], Thickness[0.002], Line[Table[{w*(i - \
1)/100, yA[nul2[[2, i]]]}, {i, 101}]], Dashing[None]};
fig2r = panel2[yR, \"r2\", \"r2_p05\", \"r2_p95\",
   Table[{Black, Text[i/10., {w + 0.1, i/10}], Line[{{w, i/10}, {w + 0.02, \
i/10}}]}, {i, 0, 10}], {}];
fig2a = panel2[yA, \"ang\", \"ang_p05\", \"ang_p95\",
   Table[{Black, Text[10*i, {w + 0.1, 1 - i/9}], Line[{{w, 1 - i/9}, {w + \
0.02, 1 - i/9}}]}, {i, 0, 9}], nullBand2];
Export[FileNameJoin[{out, \"fig2_r2.pdf\"}], fig2r]; \
Export[FileNameJoin[{out, \"fig2_ang.pdf\"}], fig2a];
GraphicsRow[{fig2r, fig2a}, ImageSize -> 900]\
\>", "Input"]
}, Open  ]],

Cell[CellGroupData[{

Cell["\<\
Figures 3 and 12: per-model R^2 (black) and angle (gray) with the PCA strips\
\>", "Section"],

Cell["\<\
(* thick: top-4 (top-16 for gpt-oss), thin: top-8 (top-32); thin curves carry \
5-95% bands over splits;
   dashed gray: median angle under shuffled sky labels (same k as the thin \
curve), with its 5-95% band *)
lss = {39, 24, 82, 50, 37, 23, 22, 22};
dumpChart[sample_] := Module[{model = models[[sample]], gpt = sample >= 7, \
kA, kB, brk, A, B, NL, P1, P2, P3, pic, l, w = 3, s = 0.5, x, wcord, scord,
    th1 = 0.004, th2 = 0.002, ls = lss[[sample]], nk, ab},
   {kA, kB} = If[gpt, {16, 32}, {4, 8}]; brk = If[gpt, 32, 8];
   P1 = Import[FileNameJoin[{data, \"strips\", model <> \
\"_sky_cov_scaled_128.csv\"}]]; P1 = Transpose[P1[[2 ;;]]][[3 ;; 130]];
   P2 = Import[FileNameJoin[{data, \"strips\", model <> \
\"_sky_cov_equal_128.csv\"}]]; P2 = Transpose[P2[[2 ;;]]][[3 ;; 130]];
   P3 = Import[FileNameJoin[{data, \"strips\", model <> \
\"_type_cov_equal_128.csv\"}]]; P3 = Transpose[P3[[2 ;;]]][[3 ;; 130]];
   pic = Transpose[{P1, P2, P3}, {3, 1, 2}];
   A = readCSV[\"split/\" <> model <> \"_split_r2_\" <> ToString[kA] <> \
\".csv\"];
   B = readCSV[\"split/\" <> model <> \"_split_r2_\" <> ToString[kB] <> \
\".csv\"];
   nk = If[FileExistsQ[FileNameJoin[{data, \"null\", \"k\" <> ToString[kB], \
model <> \"_angle_null.csv\"}]], kB, 8];
   NL = readCSV[\"null/k\" <> ToString[nk] <> \"/\" <> model <> \
\"_angle_null.csv\"];
   l = Length[B];
   x[la_] := w*((la - 0.5)/l);
   wcord[{p_, la_}] := {x[la], (-s)*(p/brk)};
   scord[{p_, la_}] := {x[la], -s - ((p - brk)/(128 - brk))*(1 - s)};
   ab[t_, lo_, hi_, f_] := Polygon[Join[Table[{x[i], f[t[[i, lo]]]}, {i, l}], \
Table[{x[i], f[t[[i, hi]]]}, {i, l, 1, -1}]]];
   Graphics[{EdgeForm[],
     Table[{RGBColor @@ (1 - Sqrt[#1] &) /@ pic[[p, la]], Polygon[(wcord[{p, \
la} - #1] &) /@ ({{0, -1}, {0, 1}, {2, 1}, {2, -1}}/2)]}, {p, 1, brk}, {la, \
1, l}],
     Table[{RGBColor @@ (1 - Sqrt[#1] &) /@ pic[[p, la]], Polygon[(scord[{p, \
la} - #1] &) /@ ({{0, -1}, {0, 1}, {2, 1}, {2, -1}}/2)]}, {p, brk + 1, 128}, \
{la, 1, l}],
     (* null of the angle *)
     nullGray, Opacity[nullOpacity], ab[NL, \"null_ang_p05\", \
\"null_ang_p95\", Clip[1 - #/90, {0, 1}] &], Opacity[1],
     Dashing[{0.008, 0.008}], Thickness[th2], Line[Table[{x[i], Clip[1 - \
NL[[i, \"null_ang_p50\"]]/90, {0, 1}]}, {i, l}]], Dashing[None],
     (* bands of the thin curves *)
     GrayLevel[0.75], Opacity[0.3], ab[B, \"ang_p05\", \"ang_p95\", Clip[1 - \
#/90, {0, 1}] &],
     Black, Opacity[0.12], ab[B, \"r2_p05\", \"r2_p95\", Clip[#, {0, 1}] &], \
Opacity[1],
     Thickness[th1], GrayLevel[0.75], Line[Table[{x[i], 1 - A[[i, \
\"ang\"]]/90}, {i, 1, l}]],
     Thickness[th2], Line[Table[{x[i], 1 - B[[i, \"ang\"]]/90}, {i, 1, l}]],
     Black, Thickness[th1], Line[Table[{x[i], Max[A[[i, \"r2\"]], 0]}, {i, 1, \
l}]],
     Thickness[th2], Line[Table[{x[i], Max[B[[i, \"r2\"]], 0]}, {i, 1, l}]],
     Dashing[None], Thickness[0.001], Line[{{w, 1}, {w, -1}, {0, -1}, {0, 1}, \
{w, 1}, {w, 0}, {0, 0}}],
     Table[{Text[10*i, {x[10*i + 1], 1.1}], Line[{{x[10*i + 1], 1.07}, \
{x[10*i + 1], 1}}], Text[10*i, {x[10*i + 1], -1.1}], Line[{{x[10*i + 1], \
-1.07}, {x[10*i + 1], -1}}]}, {i, 0, Floor[l/10]}],
     Table[{Line[{{x[i + 1], 1.03}, {x[i + 1], 1}}], Line[{{x[i + 1], -1.03}, \
{x[i + 1], -1}}]}, {i, 1, l - 1}],
     Table[{Line[{{x[5*i + 1], 1.06}, {x[5*i + 1], 1}}], Line[{{x[5*i + 1], \
-1.06}, {x[5*i + 1], -1}}]}, {i, 1, Floor[(l - 1)/5]}],
     Table[{Line[{{-0.05, i}, {0, i}}]}, {i, 0, 1, 0.1}],
     Table[{Text[i, {-0.12, i + 0.02}], Line[{{-0.08, i}, {0, i}}]}, {i, 0, \
1}],
     Text[Style[Superscript[\"R\", 2], 15], {-0.15, 0.5}], Text[Style[\"layer\
\", 15], {w/2, -1.25}], Text[Style[mmodels[[sample]], 16], {w/4, 0.75}],
     Gray, Table[{Text[10*i, {w + 0.1, 1 - i/9}], Line[{{w, 1 - i/9}, {w + \
0.02, 1 - i/9}}]}, {i, 0, 9, 1}], Text[Style[\"\[Alpha]\", 15], {w + 0.25, \
0.5}], Black,
     Line[{{{x[ls + 1], -s/2}, {w + 0.02, -s/2}}, {{x[ls + 1], -s}, {w + \
0.02, -s}}, {{w, -1}, {w + 0.02, -1}}}],
     Text[brk, {w + 0.1, -s}, Automatic, {0, -1}], Text[brk/2, {w + 0.1, \
-s/2}, Automatic, {0, -1}], Text[128, {w + 0.1, -1}, Automatic, {0, -1}],
     Text[Style[\"PCA\", 15], {w + 0.1, -0.75}, Automatic, {0, -1}]}, \
ImageSize -> 420]];
dumps = Table[dumpChart[i], {i, 1, 8}];
Do[Export[FileNameJoin[{out, models[[i]] <> \"_dump.pdf\"}], dumps[[i]]], {i, \
1, 8}];
GraphicsGrid[Partition[dumps, 2], ImageSize -> 900]\
\>", "Input"]
}, Open  ]],

Cell[CellGroupData[{

Cell["\<\
Figures 5 and 16: ablation, with 95% intervals and the shuffled-answer \
baseline\
\>", "Section"],

Cell[CellGroupData[{

Cell["\<\
(* models are picked by name (the paper's cell had Qwen3-235B and Qwen3-32B \
swapped);
   intervals resample query objects (rebuttal/intervals.py); gray band at the \
bottom: the median
   separation when query objects are shuffled against each model's answers, \
5-95% over shuffles *)
AB = readCSV[\"ablation/ablation_intervals.csv\"]; BL = \
readCSV[\"ablation/baseline_angle.csv\"];
abModels = {\"mistrallarge123b\", \"glm45air\", \"qwen235b\", \"qwen32b\", \
\"llama33_70b\", \"mixtral8x22b\", \"gptoss120b_harmony\"};
abNames = {\"Mistral Large 2\", \"GLM-4.5-Air\", \"Qwen3-235B\", \
\"Qwen3-32B\", \"Llama-3.3-70B\", \"Mixtral-8x22B\", \"gpt-oss-120b*\"};
conds = {\"none\", \"comp8\", \"l2pure\", \"sky3\", \"l2raw\", \"harm8\"}; \
reg = {\"0\", \"8\[UpTee]\", \"(l=2)\[UpTee]\", \"l=1\", \"l=2\", \"l=1,2\"};
ab[m_, c_] := row1[AB, #model === m && #condition === c &];
shuf = Select[BL, #baseline === \"answers_shuffled\" && MemberQ[abModels, \
#model] &];
shufLo = Min[#[\"p05\"] & /@ shuf]; shufHi = Max[#[\"p95\"] & /@ shuf]; \
shufMed = Mean[#[\"median_deg\"] & /@ shuf];
cap = 0.012; dxm = 0.014;
figAbl = Graphics[{Thickness[0.001], Gray, Table[Line[{{0, i/9}, {2.5, \
i/9}}], {i, 1, 8}], Table[Line[{{i/2, 0}, {i/2, 1}}], {i, 1, 4}],
    nullGray, Opacity[nullOpacity], EdgeForm[], Polygon[{{0, 0}, {2.5, 0}, \
{2.5, Clip[1 - shufLo/90, {0, 1}]}, {0, Clip[1 - shufLo/90, {0, 1}]}}], \
Opacity[1],
    Dashing[{0.01, 0.01}], Line[{{0, Clip[1 - shufMed/90, {0, 1}]}, {2.5, \
Clip[1 - shufMed/90, {0, 1}]}}], Dashing[None],
    Table[With[{m = abModels[[j]], d = (j - 4)*dxm}, {RGBColor @@ cols[[j]], \
Text[Style[abNames[[j]], 12, Bold], {-0.7, 1 - (j - 0.5)/7}],
       Thickness[0.004], Line[Table[{(k - 1)/2, 1 - ab[m, \
conds[[k]]][\"median_deg\"]/90}, {k, 1, 6}]],
       Thickness[0.0015], Table[With[{r = ab[m, conds[[k]]], xx = (k - 1)/2 + \
d},
         {Line[{{xx, 1 - r[\"ci95_lo\"]/90}, {xx, 1 - r[\"ci95_hi\"]/90}}], \
Line[{{xx - cap, 1 - r[\"ci95_lo\"]/90}, {xx + cap, 1 - r[\"ci95_lo\"]/90}}],
          Line[{{xx - cap, 1 - r[\"ci95_hi\"]/90}, {xx + cap, 1 - r[\"ci95_hi\
\"]/90}}]}], {k, 1, 6}]}], {j, 1, 7}],
    Black, Thickness[0.001], Line[{{0, 0}, {0, 1}, {2.5, 1}, {2.5, 0}, {0, \
0}}],
    Gray, Table[{Text[10*i, {-0.1, 1 - i/9}], Text[10*i, {2.6, 1 - i/9}]}, \
{i, 0, 9}],
    Text[Style[\"shuffled\", 9], {2.47, 0.035}, {1, 0}],
    Black, Table[Text[Style[reg[[i]], Bold, 12], {(i - 1)/2, -0.15}], {i, 1, \
6}]}, ImageSize -> 400];
(*Export[FileNameJoin[{out, \"ablation.pdf\"}], figAbl];*)
figAbl\
\>", "Input",
 CellChangeTimes->{{4.0037590545170746`*^9, 4.003759057732559*^9}},
 CellLabel->"In[79]:=",ExpressionUUID->"ff91730f-6bbb-49c9-b868-04ddf2c79b90"],

